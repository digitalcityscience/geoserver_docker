############################
# GLOBAL
############################
# Dedicated Compose project: its network and named volumes do not overlap with
# another local TOSCA Backend stack.
COMPOSE_PROJECT_NAME=geoserver_2285_jdbc_dev

############################
# POSTGRES / POSTGIS (optional GeoServer companion database)
############################
PG_HOST=db
# 5438 is commonly occupied by the TOSCA Backend stack.
PG_PORT=5448
POSTGRES_CONTAINER_NAME=geoserver-2285-db
PG_DATABASE=geoserver
PG_DOCKER_PORT=5432

# PostgreSQL superuser
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres

############################
# GEOSERVER DATABASE ROLE
############################
PG_GS_USER=geoserver
PG_GS_PASSWORD=postgres_gs

############################
# GEOSERVER DATABASE SCHEMAS
############################
PG_SCHEMA_GEOSERVER=gs_auth_role_schema
PG_SCHEMA_GIS=gis_schema
PG_SCHEMA_JDBCCONF=gs_jdbcconfig_schema
############################
# GEOSERVER CORE
############################
GEOSERVER_VERSION=2.28.5
# Host port only; GeoServer still listens on 8080 inside its container.
GEOSERVER_PORT=8383
GEOSERVER_CONTAINER_NAME=geoserver-2285
GEOSERVER_DATA_DIR=/geoserver_data/data

GEOSERVER_ADMIN_USER=admin2
GEOSERVER_ADMIN_PASSWORD=geoserver2

############################
# GEOSERVER – JDBC BACKEND
############################
GEOSERVER_DB_BACKEND=POSTGRES
GEOSERVER_DB_HOST=${PG_HOST}
GEOSERVER_DB_PORT=${PG_DOCKER_PORT}
GEOSERVER_DB_NAME=${PG_DATABASE}
GEOSERVER_DB_USER=${PG_GS_USER}
GEOSERVER_DB_PASSWORD=${PG_GS_PASSWORD}
GEOSERVER_DB_SCHEMA=${PG_SCHEMA_GEOSERVER}

# JDBC URL (roles + jdbcconfig)
GS_JDBC_URL=jdbc:postgresql://${PG_HOST}:${PG_DOCKER_PORT}/${PG_DATABASE}?currentSchema=${PG_SCHEMA_GEOSERVER}

############################
# GEOSERVER – ROLE SERVICE
############################
GS_ROLE_SERVICE_NAME=jdbc_role
GS_ADMIN_ROLE=ADMIN
GS_GROUP_ADMIN_ROLE=GROUP_ADMIN

############################
# GEOSERVER – JVM
############################
GEOSERVER_JVM_XMS=1G
GEOSERVER_JVM_XMX=2G

############################
# GEOSERVER – PLUGINS
#  When you add new plugin, it will be installed automatically on GeoServer startup but it will take while for first startup.
#  !!!    so be patient !!!!
# or if you need one of the plugins for your project, please add it github action settings and publish your own image.
# You will save time for every new startup.
############################

OFFICIAL_PLUGINS=gdal,monitor,vectortiles,mbstyle
COMMUNITY_PLUGINS=jdbcconfig,jdbcstore,sec-oauth2-openid-connect

############################
# GEOSERVER – JDBC SECURITY
# This test stack is prepared for JDBC roles and JDBC authentication. The
# activation script applies the JDBC services after GeoServer and PostGIS start.
GEOSERVER_SECURITY_MODE=jdbc-auth-role
GEOSERVER_ENABLE_JDBC_ROLE=true
GEOSERVER_ENABLE_JDBC_AUTH=true
ENABLE_JDBC_LOGIN=true

# JDBCConfig is separate from JDBC security. It stores GeoServer catalog data
# (workspaces, datastores/stores, layers, styles, services, and settings) in
# PostgreSQL. It does NOT control JDBC users, authentication, or roles.
#
# false: only security uses PostgreSQL; catalog/config remains in
#        /geoserver_data/data (the normal and safer starting point).
# true:  enable the JDBCConfig extension to persist catalog/config in
#        PG_SCHEMA_JDBCCONF. Test this separately before production use.
ENABLE_JDBC_CONFIG=false
JDBC_LOGIN_SERVICE_NAME=jdbc_login
JDBC_AUTH_SERVICE_NAME=jdbc_auth


############################
# GEOSERVER – CORS
############################
GEOSERVER_CORS_ENABLED=true
GEOSERVER_CORS_ALLOWED_ORIGINS=*
GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=*

############################
# GEOSERVER – OPTIONAL
############################
DISK_QUOTA_ENABLED=false
