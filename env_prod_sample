############################
# GLOBAL
############################
COMPOSE_PROJECT_NAME=tosca_geoserver_dev

############################
# ENV MODE
############################
ENV=dev
PROD_MODE=false

############################
# POSTGRES (Shared DB)
############################
PG_HOST=db
PG_PORT=5438              # host->container port mapping (compose)
PG_DOCKER_PORT=5432        # container internal port
PG_DATABASE=tosca

# PostgreSQL superuser (init / maintenance)
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres

############################
# APPLICATION DB USERS
############################
# Django (API)
PG_API_USER=tosca_api
PG_API_PASSWORD=postgres_api
PG_SCHEMA_API=api_schema

# GeoServer (used by JDBC security + jdbcconfig/jdbcstore)
PG_GS_USER=tosca_gs
PG_GS_PASSWORD=postgres_gs
PG_SCHEMA_GEOSERVER=gs_auth_role_schema
PG_SCHEMA_JDBCCONF=gs_jdbcconfig_schema
PG_SCHEMA_GIS=gis_schema

############################
# GEOSERVER CORE
############################
GEOSERVER_VERSION=2.27.2
GEOSERVER_PORT=8080
GEOSERVER_DATA_DIR=/geoserver_data/data

# Initial UI/REST admin (bootstrap user)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

############################
# REVERSE PROXY / PUBLIC URL
############################
# DEV: usually empty (no proxy). If you access via a host domain, set it.
# Example (dev): http://localhost:8080/geoserver
PROXY_BASE_URL=

############################
# GEOSERVER – JDBC BACKEND (security + jdbcconfig)
############################
GEOSERVER_DB_BACKEND=POSTGRES
GEOSERVER_DB_HOST=${PG_HOST}
GEOSERVER_DB_PORT=${PG_DOCKER_PORT}
GEOSERVER_DB_NAME=${PG_DATABASE}
GEOSERVER_DB_USER=${PG_GS_USER}
GEOSERVER_DB_PASSWORD=${PG_GS_PASSWORD}
GEOSERVER_DB_SCHEMA=${PG_SCHEMA_GEOSERVER}

# JDBC URL used by templates (roles/login services)
GS_JDBC_URL=jdbc:postgresql://${PG_HOST}:${PG_DOCKER_PORT}/${PG_DATABASE}?currentSchema=${PG_SCHEMA_GEOSERVER}

############################
# GEOSERVER – JDBC SECURITY SERVICES
############################
ENABLE_JDBC_LOGIN=true
JDBC_LOGIN_SERVICE_NAME=jdbc_login
JDBC_AUTH_SERVICE_NAME=jdbc_auth

# Role service naming + seed roles
GS_ROLE_SERVICE_NAME=jdbc_role
GS_ADMIN_ROLE=ADMIN
GS_GROUP_ADMIN_ROLE=GROUP_ADMIN

############################
# GEOSERVER – JDBC CONFIG BACKEND (catalog in DB)
############################
ENABLE_JDBC_CONFIG=true
# jdbcconfig connects using PG_SCHEMA_JDBCCONF (your bootstrap script sets it)

############################
# GEOSERVER – JVM
############################
GEOSERVER_JVM_XMS=1G
GEOSERVER_JVM_XMX=2G

############################
# GEOSERVER – PLUGINS
#  When you add new plugin, it will be installed automatically on GeoServer startup but it will take while for first startup.
#  !!!    so be patient !!!!
# or if you need one of the plugins for your project, please add it github action settings and publish your own image.
# You will save time for every new startup.
############################
OFFICIAL_PLUGINS=gdal,monitor,vectortiles,mbstyle
COMMUNITY_PLUGINS=jdbcconfig,jdbcstore,sec-oauth2-openid-connect

############################
# GEOSERVER – CORS
############################
GEOSERVER_CORS_ENABLED=true

# DEV OPTION A (recommended): restrict to your dev frontend origins
# Example: http://localhost:5173,https://dev.your-frontend.tld
GEOSERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# DEV OPTION B (only if you really need): allow all (NOT for prod)
# GEOSERVER_CORS_ALLOWED_ORIGINS=*

GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=Authorization,Content-Type

